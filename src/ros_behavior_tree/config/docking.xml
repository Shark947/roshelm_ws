<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="MainTree">

  <BehaviorTree ID="InitParams">
    <Sequence name="bb_init">
      <SetBlackboard output_key="gotodepth_lift_params"
                     value="name=gotodepth_lift;pwt=100;perpetual=true;updates=GOTO_DEPTH_UPDATES;runflag=DET_LIGPOWER=true;runflag=DET_CAMSONPOWER=true;runflag=DET_MAGPOWER=true;endflag=GOTO_DEPTH=false;endflag=MODE=SURVEY;capture_delta=0.5;depth=74,20;repeat=0"/>

      <SetBlackboard output_key="survey_const_speed_params"
                     value="name=const_speed_survey;pwt=100;perpetual=false;updates=SPEED_UPDATE;endflag=SPD=false;speed=0.1;duration=no-time-limit;duration_reset=CONST_SPD_RESET=true"/>

      <SetBlackboard output_key="survey_const_depth_params"
                     value="name=const_depth_survey;pwt=100;duration=no-time-limit;updates=DEPTH_UPDATE;depth=75;peakwidth=1;basewidth=1.5;summitdelta=20"/>

      <SetBlackboard output_key="survey_waypoint_params"
                     value="name=waypt_survey;pwt=100;perpetual=true;updates=WPT_UPDATE;runflag=DET_CAMSONPOWER=true;runflag=DET_LIGPOWER=true;endflag=DET_CAMSONPOWER=false;endflag=DET_LIGPOWER=false;endflag=DET_MAGPOWER=false;endflag=MODE=RETURNING;speed=0.05;capture_line=true;capture_radius=2;slip_radius=4;efficiency_measure=all;polygon=-3,-3;order=normal;repeat=0"/>

      <SetBlackboard output_key="return_const_speed_params"
                     value="name=const_speed_return;pwt=100;perpetual=false;updates=SPEED_UPDATE;endflag=SPD=false;speed=0.1;duration=no-time-limit;duration_reset=CONST_SPD_RESET=true"/>

      <SetBlackboard output_key="return_const_depth_params"
                     value="name=const_depth_return;pwt=100;duration=no-time-limit;updates=DEPTH_UPDATE;depth=75;peakwidth=1;basewidth=1.5;summitdelta=20"/>

      <SetBlackboard output_key="return_waypoint_params"
                     value="name=waypt_returning;pwt=100;perpetual=true;updates=WPT_UPDATE;runflag=DET_CAMSONPOWER=true;runflag=DET_LIGPOWER=true;endflag=DET_CAMSONPOWER=false;endflag=DET_LIGPOWER=false;endflag=RETURN1=true;speed=0.05;capture_line=true;capture_radius=0.1;slip_radius=2;efficiency_measure=all;polygon=0,0;order=normal;repeat=100000"/>

      <SetBlackboard output_key="station_keep_params"
                     value="name=station-keep;pwt=100;endflag=STATIONPHASE=STATIONCOMPLETED;center_activate=false;hibernation_radius=-1;inner_radius=0.3;outer_radius=1.5;outer_speed=0.15;transit_speed=0.2;station_pt=0,0;swing_time=0;visual_hints=vertex_size=1;visual_hints=edge_color=light_blue;visual_hints=edge_size=1;visual_hints=label_color=white;visual_hints=vertex_color=red"/>

      <SetBlackboard output_key="dock_depth_params"
                     value="name=bhv_depth;pwt=100;duration=no-time-limit;updates=DOCKDEPTH_UPDATE;depth=0;peakwidth=1;basewidth=1.5;summitdelta=20"/>

      <SetBlackboard output_key="dock_heading_params"
                     value="name=const_hdg;pwt=1;perpetual=true;duration=no-time-limit;updates=DOCKHDG_UPDATES;basewidth=10;heading=90;heading_mismatch_var=HDG_DIFF;peakwidth=10;summitdelta=25"/>

      <SetBlackboard output_key="gotodepth_detect_params"
                     value="name=gotodepth_detect;pwt=100;perpetual=true;updates=GOTO_DEPTH_DETECT_UPDATES;runflag=CONSTHEIGHT=true;runflag=DET_LIGPOWER=true;runflag=DET_CAMSONPOWER=true;endflag=GOTO_DEPTH=false;endflag=MODE=DETECTING;capture_delta=0.5;depth=74,30;repeat=0"/>

      <SetBlackboard output_key="detect_const_speed_params"
                     value="name=const_speed_detect;pwt=100;perpetual=false;updates=DETECT_SPEED_UPDATE;endflag=SPD=false;speed=0.1;duration=no-time-limit;duration_reset=CONST_SPD_RESET=true"/>

      <SetBlackboard output_key="detect_const_depth_params"
                     value="name=const_depth_detect;pwt=100;duration=no-time-limit;updates=DETECT_DEPTH_UPDATE;depth=77;peakwidth=1;basewidth=1.5;summitdelta=20"/>

      <SetBlackboard output_key="detect_waypoint_params"
                     value="name=waypt_detect;pwt=100;perpetual=true;updates=DETECT_WPT_UPDATE;runflag=DET_CAMSONPOWER=true;runflag=DET_LIGPOWER=true;endflag=DET_CAMSONPOWER=false;endflag=DET_LIGPOWER=false;endflag=MODE=UPFLOAT;speed=0.05;capture_line=true;capture_radius=2;slip_radius=4;efficiency_measure=all;polygon=3,3;order=normal;repeat=0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Sequence name="main_root">
      <SubTree ID="InitParams" name="init_params" __shared_blackboard="true"/>

      <Fallback name="docking_root">
        <ReactiveSequence name="lift_sequence">
          <DeployTriggered />
          <Inverter>
            <ReturnTriggered />
          </Inverter>
          <ModeCondition value="LIFT"/>
          <GoToDepthAction params="{gotodepth_lift_params}"/>
        </ReactiveSequence>

        <ReactiveSequence name="survey_sequence">
          <DeployTriggered />
          <Inverter>
            <ReturnTriggered />
          </Inverter>
          <ModeCondition value="SURVEY"/>
          <Parallel name="survey_parallel" success_threshold="3" failure_threshold="3">
            <ConstantSpeedAction params="{survey_const_speed_params}"/>
            <ConstantDepthAction params="{survey_const_depth_params}"/>
            <WaypointAction params="{survey_waypoint_params}"/>
          </Parallel>
        </ReactiveSequence>

        <ReactiveSequence name="return_sequence">
          <DeployTriggered />
          <Inverter>
            <ReturnTriggered />
          </Inverter>
          <ModeCondition value="CLOSETODOCKING|RETURNING"/>
          <Parallel name="return_parallel" success_threshold="3" failure_threshold="3">
            <ConstantSpeedAction params="{return_const_speed_params}"/>
            <ConstantDepthAction params="{return_const_depth_params}"/>
            <WaypointAction params="{return_waypoint_params}"/>
          </Parallel>
        </ReactiveSequence>

        <ReactiveSequence name="dock_sequence">
          <DeployTriggered />
          <Inverter>
            <ReturnTriggered />
          </Inverter>
          <ModeCondition value="DOCKING"/>
          <Parallel name="dock_parallel" success_threshold="2" failure_threshold="2">
            <ConstantDepthAction params="{dock_depth_params}"/>
            <ReactiveFallback name="dock_station_or_heading">
              <ReactiveSequence name="station_keep_sequence">
                <StationingCondition value="true"/>
                <StationKeepAction params="{station_keep_params}"/>
              </ReactiveSequence>

              <ReactiveSequence name="heading_sequence">
                <StationingCondition value="false"/>
                <ConstantHeadingAction params="{dock_heading_params}"/>
              </ReactiveSequence>
            </ReactiveFallback>
          </Parallel>
        </ReactiveSequence>

        <ReactiveSequence name="gotodetect_sequence">
          <DeployTriggered />
          <Inverter>
            <ReturnTriggered />
          </Inverter>
          <ModeCondition value="GOTODETECT"/>
          <GoToDepthAction params="{gotodepth_detect_params}"/>
        </ReactiveSequence>

        <ReactiveSequence name="detect_sequence">
          <DeployTriggered />
          <Inverter>
            <ReturnTriggered />
          </Inverter>
          <ModeCondition value="DETECTING"/>
          <Parallel name="detect_parallel" success_threshold="3" failure_threshold="3">
            <ConstantSpeedAction params="{detect_const_speed_params}"/>
            <ConstantDepthAction params="{detect_const_depth_params}"/>
            <WaypointAction params="{detect_waypoint_params}"/>
          </Parallel>
        </ReactiveSequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

</root>
