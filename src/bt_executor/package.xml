<?xml version="1.0"?>
<package format="2">
  <name>bt_executor</name>
  <version>0.2.0</version>
  <description>BehaviorTree-based docking scheduler that reuses MOOS-IvP lib_behaviors-marine behaviors.</description>

  <maintainer email="xing@todo.todo">xing</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>behaviortree_cpp_v3</depend>
  <depend>common_msgs</depend>
  <depend>docking_optical_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ros_helm</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>std_msgs</depend>

  <test_depend>gtest</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>
